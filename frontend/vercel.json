{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "destination": "/library-dashboard",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/library-dashboard/api/:path*",
      "destination": "https://eatyummydance200.tail72d30b.ts.net/library-dashboard/api/:path*"
    },
    {
      "source": "/library-dashboard/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/library-dashboard/OFL.txt",
      "destination": "/OFL.txt"
    },
    {
      "source": "/library-dashboard/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/library-dashboard/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ],
  "trailingSlash": false
}
